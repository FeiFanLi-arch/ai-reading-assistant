# ==============================================================================
# 个人 AI 阅读助手 (Personal AI Reading Assistant) - 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置：cp .env.example .env
# ==============================================================================

# --- 服务运行配置 ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./data/reading_assistant.db

# --- AI 大模型配置 (兼容所有 OpenAI 接口格式：OpenAI / DeepSeek / 通义千问 / 硅基流动 / Ollama) ---
# 提示：如果不配置 API Key，系统将自动启用「内置智能文本分析引擎 (Local Smart Engine)」，
# 依然可以完整体验结构化摘要、批判性追问、多文章主题对比等全部核心功能！
# 你也可以在启动后直接在 Web 界面右上角的「AI 引擎设置」中动态配置或切换。
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60

# --- 网页抓取配置 ---
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# --- 初始化配置 ---
# 首次启动时是否自动写入示例文章与对比主题（true / false）
SEED_DEMO_DATA=true
