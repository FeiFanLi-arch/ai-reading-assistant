# auto: configured key -> real AI; no key -> clearly labeled local demo
# demo: always offline text extraction/templates; ai: key is required
AI_MODE=auto
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Optional: set a long random token; enter it in the web Settings panel.
APP_ACCESS_TOKEN=
# Docker binds only to localhost by default.
PORT=8000
# Local Python only. Docker always uses its named volume at /app/data/reader.db.
DB_PATH=./data/reader.db
